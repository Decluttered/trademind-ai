{
  "envelope": {
    "success": ["code", "message", "data"],
    "optional": ["traceId"],
    "errorCodeRule": "code must be non-zero for business errors"
  },
  "endpoints": [
    { "method": "GET", "path": "/api/v1/auth/profile", "auth": true, "responseData": "AdminProfile" },
    { "method": "GET", "path": "/api/v1/image/providers", "auth": true, "responseData": "ImageProviderList" },
    {
      "method": "GET",
      "path": "/api/v1/observability/overview",
      "auth": true,
      "responseData": "ObservabilityOverview",
      "requiredResponseFields": ["overallStatus", "metrics", "alerts", "evaluation", "slo", "telemetry", "environment", "timestamp"]
    },
    {
      "method": "GET",
      "path": "/api/v1/p10/status",
      "auth": true,
      "responseData": "ProductionRuntimeStatus",
      "requiredResponseFields": ["providerWriteReady", "productionReady"]
    },
    {
      "method": "POST",
      "path": "/api/v1/operation-tasks",
      "auth": true,
      "requestBody": ["sourceType", "sourceReference", "taskType", "platform", "title", "summary", "payload", "priority"],
      "responseData": "OperationTaskDetail"
    },
    { "method": "GET", "path": "/api/v1/operation-tasks/:id", "auth": true, "responseData": "OperationTaskDetail" },
    {
      "method": "POST",
      "path": "/api/v1/operation-tasks/:id/approve",
      "auth": true,
      "requestBody": ["draftVersion", "draftPayloadHash", "reason", "comment", "expectedTaskRevision"],
      "responseData": "ApprovalSummary"
    },
    {
      "method": "POST",
      "path": "/api/v1/operation-tasks/:id/execute",
      "auth": true,
      "requestBody": ["expectedTaskRevision", "adapterMode"],
      "responseData": "ExecutionResponse"
    },
    {
      "method": "GET",
      "path": "/api/v1/observability/alerts",
      "auth": true,
      "query": ["page", "pageSize", "status", "severity", "module"],
      "responseData": "AlertEventList"
    },
    {
      "method": "POST",
      "path": "/api/v1/observability/alerts/:id/ack",
      "auth": true,
      "requestBody": [],
      "responseData": "AlertEventStatus"
    },
    {
      "method": "POST",
      "path": "/api/v1/observability/alerts/:id/silence",
      "auth": true,
      "requestBody": ["reason", "durationHours"],
      "responseData": "AlertEventSilence"
    },
    { "method": "GET", "path": "/api/v1/products/:id", "auth": true, "responseData": "ProductDetail" },
    { "method": "GET", "path": "/api/v1/products/:id/readiness", "auth": true, "query": ["platform", "shopId", "mode"], "responseData": "ProductReadinessResult" },
    { "method": "GET", "path": "/api/v1/products/:id/publications", "auth": true, "responseData": "ProductPublicationList" },
    { "method": "GET", "path": "/api/v1/product-publications/:id/douyin/sku-bindings", "auth": true, "responseData": "DouyinSkuBindingSummary" },
    { "method": "GET", "path": "/api/v1/products/:id/publish-targets", "auth": true, "responseData": "PublishTargetsResponse" },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/publish-targets/create-drafts",
      "auth": true,
      "requestBody": ["targets", "onlyReady", "retryFailedOnly"],
      "responseData": "PublishTargetsCreateDraftsResponse",
      "douyinPolicy": "reject_entire_request_before_write"
    },
    {
      "method": "POST",
      "path": "/api/v1/product-publish/batch-targets/create-drafts",
      "auth": true,
      "requestBody": ["productIds", "targets", "onlyReady", "includeWarnings", "commonConfig", "overrides", "force"],
      "responseData": "BatchTargetsCreateDraftsResponse",
      "douyinPolicy": "reject_entire_request_before_idempotency_or_batch_write"
    },
    {
      "method": "POST",
      "path": "/api/v1/product-publish/tasks/:id/retry",
      "auth": true,
      "requestBody": [],
      "responseData": "ProductPublishTaskDTO",
      "douyinPolicy": "reject_without_task_state_change"
    },
    {
      "method": "POST",
      "path": "/api/v1/product-publish/tasks/:id/recover-douyin-draft",
      "auth": true,
      "requestBody": [],
      "responseData": "ProductPublishTaskDTO",
      "requiredPermission": "operationtask.execute",
      "douyinPolicy": "read_only_reconcile_result_unknown_only",
      "fixedStateError": {
        "httpStatus": 409,
        "dataErrorCode": "DOUYIN_RECOVERY_NOT_ALLOWED"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/product-publish/batches/:id/retry-failed",
      "auth": true,
      "requestBody": [],
      "responseData": "BatchTargetsCreateDraftsResponse",
      "douyinPolicy": "reject_entire_batch_without_task_state_change"
    },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/platform-configs/douyin_shop/create-draft",
      "auth": true,
      "requestBody": ["shopId", "publishMode", "force"],
      "responseData": "OperationTaskRequiredError",
      "fixedError": {
        "httpStatus": 409,
        "dataErrorCode": "DOUYIN_OPERATION_TASK_REQUIRED"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/publish",
      "auth": true,
      "requestBody": ["shopId", "options", "force"],
      "responseData": "ProductPublishTaskDTO",
      "douyinPolicy": "reject_before_task_write"
    },
    { "method": "GET", "path": "/api/v1/customer/dashboard", "auth": true, "responseData": "CustomerDashboardSummary" },
    { "method": "GET", "path": "/api/v1/customer/auto-reply-setting", "auth": true, "responseData": "CustomerAutoReplySetting" },
    {
      "method": "PUT",
      "path": "/api/v1/customer/auto-reply-setting",
      "auth": true,
      "requestBody": ["messageSyncEnabled", "autoReplyEnabled", "pollIntervalSeconds"],
      "responseData": "CustomerAutoReplySetting"
    },
    { "method": "GET", "path": "/api/v1/customer/shops/:shopId/auto-reply-policy", "auth": true, "responseData": "CustomerAutoReplyPolicy" },
    {
      "method": "PUT",
      "path": "/api/v1/customer/shops/:shopId/auto-reply-policy",
      "auth": true,
      "requestBody": ["enabled", "tone", "shopPolicy", "maxReplyRunes", "maxRepliesPerHour", "requireOrderContext", "lowRiskOnly"],
      "responseData": "CustomerAutoReplyPolicy"
    },
    { "method": "GET", "path": "/api/v1/customer/shops/:shopId/auto-reply-runs", "auth": true, "responseData": "CustomerAutoReplyRunList" },
    {
      "method": "POST",
      "path": "/api/v1/customer/conversations/:id/send-platform-message",
      "auth": true,
      "requestBody": ["reply", "clientMessageId", "suggestionId"],
      "responseData": "CustomerMessage"
    },
    { "method": "POST", "path": "/v1/discovery-runs", "auth": true, "idempotencyKey": true, "requestBody": ["url"], "responseData": "MindBayCaptureResult" },
    { "method": "GET", "path": "/v1/products", "auth": true, "query": ["q", "collectionId", "minScore", "cursor", "limit"], "responseData": "MindBayProductCursorPage" },
    { "method": "GET", "path": "/v1/collections", "auth": true, "query": ["cursor", "limit"], "responseData": "MindBayCollectionCursorPage" },
    { "method": "POST", "path": "/v1/collections", "auth": true, "idempotencyKey": true, "requestBody": ["name", "kind", "description", "rules"], "responseData": "MindBayCollection" },
    { "method": "POST", "path": "/v1/collections/:id/products", "auth": true, "idempotencyKey": true, "requestBody": ["sourceProductId", "reason"], "responseData": "MindBayCollectionProduct" },
    { "method": "POST", "path": "/v1/listing-drafts", "auth": true, "idempotencyKey": true, "responseData": "MindBayListingDraft" },
    { "method": "GET", "path": "/v1/listing-drafts", "auth": true, "query": ["state", "cursor", "limit"], "responseData": "MindBayListingDraftCursorPage" },
    { "method": "GET", "path": "/v1/listing-drafts/:id", "auth": true, "responseData": "MindBayListingDraftDetail" },
    { "method": "POST", "path": "/v1/listing-drafts/:id/validate", "auth": true, "idempotencyKey": true, "responseData": "MindBayValidationResult" },
    { "method": "POST", "path": "/v1/listing-drafts/:id/generate", "auth": true, "idempotencyKey": true, "responseData": "MindBayContentVersion" },
    { "method": "POST", "path": "/v1/image-assets", "auth": true, "idempotencyKey": true, "requestBody": ["originUrl"], "responseData": "MindBayImageAsset" },
    { "method": "GET", "path": "/v1/gpsr-profiles", "auth": true, "responseData": "MindBayGPSRProfileList" },
    { "method": "POST", "path": "/v1/gpsr-profiles", "auth": true, "idempotencyKey": true, "requestBody": ["name", "manufacturerName", "manufacturerAddress", "responsiblePersonName", "responsiblePersonAddress", "safetyInformation", "documentReferences"], "responseData": "MindBayGPSRProfile" },
    { "method": "POST", "path": "/v1/extension-tokens", "auth": true, "responseData": "MindBayExtensionGrant" },
    { "method": "DELETE", "path": "/v1/extension-tokens/:id", "auth": true, "responseData": "MindBayExtensionGrantRevocation" },
    { "method": "POST", "path": "/v1/extension/captures", "auth": "mindbay-extension:capture", "idempotencyKey": true, "requestBody": ["url"], "responseData": "MindBayCaptureResult" },
    { "method": "GET", "path": "/api/v1/shops/:id/oauth/ebay/authorize-url", "auth": true, "responseData": "EbayAuthorizeURL" },
    { "method": "POST", "path": "/api/v1/shops/:id/oauth/ebay/callback", "auth": true, "requestBody": ["code", "state"], "responseData": "ShopDetail" },
    { "method": "GET", "path": "/api/v1/platform/ebay/categories/:categoryId/aspects", "auth": true, "responseData": "EbayCategoryAspectList" },
    { "method": "POST", "path": "/api/v1/platform/ebay/categories/:categoryId/aspects/sync", "auth": true, "responseData": "EbayCategoryAspectSync" },
    { "method": "GET", "path": "/v1/calendar/slots", "auth": true, "query": ["from", "to"], "responseData": "MindBayCalendarSlotList" },
    { "method": "POST", "path": "/v1/calendar/preview", "auth": true, "requestBody": ["startAt", "days", "maxPerDay", "minSpacingMinutes"], "responseData": "MindBayCalendarPreview" },
    { "method": "POST", "path": "/v1/calendar/apply", "auth": true, "idempotencyKey": true, "requestBody": ["shopId", "marketplace", "slots", "publishConfig"], "responseData": "MindBayCalendarApply" },
    { "method": "POST", "path": "/v1/publications/:id/approve", "auth": true, "idempotencyKey": true, "requestBody": [], "responseData": "MindBayPublicationApproval" },
    { "method": "POST", "path": "/internal/v1/mindbay/publications/:id/revalidate", "auth": "temporal-service", "requestBody": ["workspaceId"], "responseData": "MindBayPublicationValidation" },
    { "method": "POST", "path": "/internal/v1/mindbay/publications/:id/publish", "auth": "temporal-service", "requestBody": ["workspaceId"], "responseData": "MindBayMarketplaceListing" },
    { "method": "POST", "path": "/internal/v1/mindbay/publications/:id/reconcile", "auth": "temporal-service", "requestBody": ["workspaceId"], "responseData": "MindBayMarketplaceListing" },
    { "method": "GET", "path": "/v1/monitorable-listings", "auth": true, "responseData": "MindBayMarketplaceListingList" },
    { "method": "POST", "path": "/v1/monitor-runs", "auth": true, "idempotencyKey": true, "requestBody": ["marketplaceListingId", "priceRuleId", "trigger"], "responseData": "MindBayMonitorRunResult" },
    { "method": "GET", "path": "/v1/price-rules", "auth": true, "responseData": "MindBayPriceRuleList" },
    { "method": "POST", "path": "/v1/price-rules", "auth": true, "idempotencyKey": true, "requestBody": ["name", "minMarginBasisPoints", "targetMarginBasisPoints", "maxPriceCents", "maxDeltaCents", "maxDeltaBasisPoints", "cooldownSeconds", "platformFeeBasisPoints", "shippingCents", "reserveCents", "autoApply"], "responseData": "MindBayPriceRule" },
    { "method": "GET", "path": "/v1/price-decisions", "auth": true, "query": ["outcome"], "responseData": "MindBayPriceDecisionList" },
    { "method": "POST", "path": "/v1/price-decisions/:id/apply", "auth": true, "idempotencyKey": true, "requestBody": [], "responseData": "MindBayPriceDecision" },
    { "method": "GET", "path": "/v1/profit/report", "auth": true, "query": ["from", "to"], "responseData": "MindBayProfitReport" }
  ]
}
