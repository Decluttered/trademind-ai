{
  "envelope": {
    "success": ["code", "message", "data"],
    "optional": ["traceId"],
    "errorCodeRule": "code must be non-zero for business errors"
  },
  "endpoints": [
    { "method": "GET", "path": "/api/v1/auth/profile", "auth": true, "responseData": "AdminProfile" },
    { "method": "GET", "path": "/api/v1/image/providers", "auth": true, "responseData": "ImageProviderList" },
    {
      "method": "GET",
      "path": "/api/v1/observability/alerts",
      "auth": true,
      "query": ["page", "pageSize", "status", "severity", "module"],
      "responseData": "AlertEventList"
    },
    {
      "method": "POST",
      "path": "/api/v1/observability/alerts/:id/ack",
      "auth": true,
      "requestBody": [],
      "responseData": "AlertEventStatus"
    },
    {
      "method": "POST",
      "path": "/api/v1/observability/alerts/:id/silence",
      "auth": true,
      "requestBody": ["reason", "durationHours"],
      "responseData": "AlertEventSilence"
    },
    { "method": "GET", "path": "/api/v1/products/:id", "auth": true, "responseData": "ProductDetail" },
    { "method": "GET", "path": "/api/v1/products/:id/readiness", "auth": true, "query": ["platform", "shopId", "mode"], "responseData": "ProductReadinessResult" },
    { "method": "GET", "path": "/api/v1/products/:id/publications", "auth": true, "responseData": "ProductPublicationList" },
    { "method": "GET", "path": "/api/v1/product-publications/:id/douyin/sku-bindings", "auth": true, "responseData": "DouyinSkuBindingSummary" },
    { "method": "GET", "path": "/api/v1/products/:id/publish-targets", "auth": true, "responseData": "PublishTargetsResponse" },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/platform-configs/douyin_shop/create-draft",
      "auth": true,
      "requestBody": ["shopId", "publishMode", "force"],
      "responseData": "ProductPublishTaskDTO"
    },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/publish",
      "auth": true,
      "requestBody": ["shopId", "options", "force"],
      "responseData": "ProductPublishTaskDTO"
    },
    { "method": "GET", "path": "/api/v1/customer/dashboard", "auth": true, "responseData": "CustomerDashboardSummary" },
    { "method": "GET", "path": "/api/v1/customer/auto-reply-setting", "auth": true, "responseData": "CustomerAutoReplySetting" },
    {
      "method": "PUT",
      "path": "/api/v1/customer/auto-reply-setting",
      "auth": true,
      "requestBody": ["messageSyncEnabled", "autoReplyEnabled", "pollIntervalSeconds"],
      "responseData": "CustomerAutoReplySetting"
    },
    { "method": "GET", "path": "/api/v1/customer/shops/:shopId/auto-reply-policy", "auth": true, "responseData": "CustomerAutoReplyPolicy" },
    {
      "method": "PUT",
      "path": "/api/v1/customer/shops/:shopId/auto-reply-policy",
      "auth": true,
      "requestBody": ["enabled", "tone", "shopPolicy", "maxReplyRunes", "maxRepliesPerHour", "requireOrderContext", "lowRiskOnly"],
      "responseData": "CustomerAutoReplyPolicy"
    },
    { "method": "GET", "path": "/api/v1/customer/shops/:shopId/auto-reply-runs", "auth": true, "responseData": "CustomerAutoReplyRunList" },
    {
      "method": "POST",
      "path": "/api/v1/customer/conversations/:id/send-platform-message",
      "auth": true,
      "requestBody": ["reply", "clientMessageId", "suggestionId"],
      "responseData": "CustomerMessage"
    }
  ]
}
