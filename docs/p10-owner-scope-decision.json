  "decisions": [
    {"decisionId":"D01","status":"approved","ownerApproved":true,"decision":"Real Douyin Provider may be implemented in P10 through the existing InventoryProviderPort; it is currently disabled."},
    {"decisionId":"D02","status":"approved","ownerApproved":true,"decision":"The first real Provider stage is strictly read-only."},
    {"decisionId":"D03","status":"approved","ownerApproved":true,"decision":"Use independent pre-production first, then one allowlisted production shop; multiple shops and general availability are forbidden."},
    {"decisionId":"D04","status":"approved","ownerApproved":true,"decision":"Real inventory write is deferred, separately approved, and not required for initial Production Ready."},
    {"decisionId":"D05","status":"approved","ownerApproved":true,"decision":"Any future write requires one explicit manual confirmation plus idempotency, expected revision, tenant/shop allowlists, audit, and a write kill switch."},
    {"decisionId":"D06","status":"approved","ownerApproved":true,"decision":"Background Worker is disabled for initial gray; only manual trigger is allowed."},
    {"decisionId":"D07","status":"approved","ownerApproved":true,"decision":"Automatic business retry is disabled for initial gray; failures require an explicit manual rerun."},
    {"decisionId":"D08","status":"approved","ownerApproved":true,"decision":"Initial production gray is limited to one tenant, one shop, and at most 100 SKUs, enforced fail closed."},
    {"decisionId":"D09","status":"approved","ownerApproved":true,"decision":"Independent pre-production is required with isolated database, Redis, secrets, environment, deployment, domain, and observability."},
    {"decisionId":"D10","status":"approved","ownerApproved":true,"decision":"Credentials are backend-only, encrypted at rest, managed-key backed, rotatable, revocable, audited, and redacted."},
    {"decisionId":"D11","status":"approved","ownerApproved":true,"decision":"Production recovery objectives are RPO no more than 15 minutes and RTO no more than 60 minutes, proven by backup and restore drills."},
    {"decisionId":"D12","status":"approved","ownerApproved":true,"decision":"Production performance acceptance requires a dedicated host and at least three repeat runs; concrete SLOs must be frozen before G1."},
    {"decisionId":"D13","status":"approved","ownerApproved":true,"decision":"Repository baseline disposition is Option B: repair the architecture loader before final acceptance, ratchet new violations, and register 446 historical unformatted Go files as non-blocking technical debt."},
    {"decisionId":"D14","status":"approved","ownerApproved":true,"decision":"Gray Go requires both Owner and Technical Lead approval; either missing approval means No-Go."},
    {"decisionId":"D15","status":"approved","ownerApproved":true,"decision":"Owner is the final Production Ready approver after technical sign-off, operations/security sign-off, and the final production gate pass."}
  ],
