    "P9_ADMIN_PRODUCT_SOURCE": {
      "paths": [
        "admin/config/routes.ts",
        "admin/e2e/mocks/inventory-sync-p9.ts",
        "admin/e2e/specs/p9-inventory-sync.spec.ts",
