    "P9_GATE_SEMANTICS": {
      "paths": [
        "scripts/p9-entry-gate.mjs",
        "scripts/p9-final-development-closure-gate.mjs",
        "scripts/p9-plan-final-gate.mjs",
        "scripts/p9-postgres-integration-gate.mjs",
        "scripts/p9-task-batch-1-domain-persistence-gate.mjs",
        "scripts/p9-task-batch-1-scope-gate.mjs",
        "scripts/p9-task-batch-2-sku-calibration-gate.mjs",
        "scripts/p9-task-batch-3-sync-orchestration-gate.mjs",
        "scripts/p9-task-batch-4-permissions-audit-safety-gate.mjs",
        "scripts/p9-task-batch-5-backend-apis-gate.mjs",
        "scripts/p9-task-batch-6-admin-inventory-center-gate.mjs",
        "scripts/p9-task-batch-7-e2e-gate.mjs",
        "docs/p9-protected-scope-manifest.json",
        "tests/gates/p9/**"
