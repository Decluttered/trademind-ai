        "admin/src/services/inventorySyncP9.ts",
        "admin/src/services/__tests__/inventorySyncP9.test.ts"
      ]
    },
    "P9_API_CONTRACT": {
      "paths": [
        "docs/api.md",
        "backend/internal/api/router.go",
        "backend/internal/modules/inventorysyncp9/api_*.go",
        "admin/src/services/inventorySyncP9.ts",
        "admin/src/services/__tests__/inventorySyncP9.test.ts"
      ]
    },
    "P9_SCOPE_AND_ACCEPTANCE": {
      "paths": [
        "docs/P9_EXECUTION_PLAN.md",
        "docs/p9-execution-plan.json",
        "docs/P9_OWNER_SCOPE_DECISION.md",
        "docs/p9-owner-scope-decision.json"
      ]
    }
  },
  "semanticRules": [
    {
      "id": "p9-package-scripts",
      "path": "package.json",
      "category": "P9_RUNTIME_CONTRACT",
      "kind": "package_script_prefixes",
      "includePrefixes": [
        "p9:",
        "test:p9"
      ],
      "excludeKeys": [
        "p9:p10-transition-gate",
        "test:p9-to-p10-transition"
      ]
    },
    {
      "id": "final-closure-semantics",
      "path": "docs/p9-final-development-closure.json",
      "category": "P9_SCOPE_AND_ACCEPTANCE",
      "kind": "json_fields",
      "fields": [
        "p9Complete",
        "developmentClosurePassed",
        "formalTaskTotal",
        "formalTaskCompletedCount",
        "acceptanceCriteriaTotal",
        "acceptanceCriteriaPassedCount",
        "productionReady",
        "productionAcceptancePassed",
        "p10BoundaryPreserved"
      ]
    },
    {
      "id": "final-gate-report-semantics",
      "path": "docs/p9-final-development-closure-gate.json",
      "category": "P9_SCOPE_AND_ACCEPTANCE",
      "kind": "json_fields",
      "fields": [
        "productTaskTotal",
        "productCompletedTaskCount",
        "acceptanceCriteriaTotal",
        "acceptanceCriteriaPassedCount",
        "p9Complete",
        "developmentClosurePassed",
        "productionReady",
        "productionAcceptancePassed",
        "p10BoundaryPreserved"
      ]
    }
  ],
  "nonBlockingGeneratedEvidence": {
    "paths": [
      "docs/P9_*_GATE.md",
      "docs/p9-*-gate.json",
      "docs/P9_ENTRY_GATE_REPORT.md",
      "docs/p9-entry-gate-report.json",
      "docs/P9_FINAL_DEVELOPMENT_CLOSURE.md",
      "docs/p9-final-development-closure.json",
      "docs/P9_POSTGRESQL_INTEGRATION_CLOSURE.md",
      "docs/p9-postgresql-integration-closure.json",
      "docs/P9_TASK_BATCH_7_INTEGRATION_DEVELOPMENT_CLOSURE.md",
      "docs/p9-task-batch-7-integration-development-closure.json"
    ],
    "rule": "File-level changes are report output. Protected semantic fields remain checked by semanticRules and closure integrity validation."
  }
}
