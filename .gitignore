collector/.profiles/
collector/data/storage-states/*
!collector/data/storage-states/.gitkeep
collector/data/runtime/
collector/data/snapshots/*
!collector/data/snapshots/.gitkeep
collector/data/tmp/
collector/data/cache/
# Historical bug: debug-snapshot was once mistakenly written into src/data; ignore leftovers as a safety net
collector/src/data/

