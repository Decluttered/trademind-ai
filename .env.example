# =============================================================================
# TradeMind Environment Variables — Single Source of Truth Template
# =============================================================================
#
# [Purpose of this file]
#   The complete variable contract shared by all environments. Copy to this repo's root `.env` and modify as needed.
#
# [How to use]
#   cp .env.example .env          # Linux / macOS
#   Copy-Item .env.example .env   # Windows PowerShell
#   Never commit `.env` to Git (already in .gitignore).
#
# [Single configuration system]
#   .env          The only runtime config; must stay Git-ignored, may hold local or server secrets.
#   .env.example  The only committable template; only empty values, obvious placeholders, and safe defaults allowed.
#
# [Load order] Process environment variables > repo-root `.env` > non-sensitive safe defaults in code.
# Environment is selected via APP_ENV; do not add .env.local / .env.test / .env.staging or similar variants.
# Details: docs/env.md · docs/ENVIRONMENT_PROFILE_GUIDE.md
# =============================================================================

# Docker Compose image selection. Local builds keep these defaults; GHCR deployments
# may use branch/version tags or immutable image@sha256:<manifest-digest> references.
TRADEMIND_BACKEND_IMAGE=local/trademind-backend:local
TRADEMIND_ADMIN_IMAGE=local/trademind-admin:local
TRADEMIND_COLLECTOR_IMAGE=local/trademind-collector:local

# Application
# Official environments: development / test / staging / production.
# demo / performance also exist but are only used for controlled demos and isolated load testing; they don't have dedicated ENV files.
APP_ENV=development
APP_NAME=TradeMind
APP_VERSION=
APP_HTTP_ADDR=:8080
GIN_MODE=debug

# MindBay Phase 0 placeholders. They are documented architecture defaults and do
# not enable Temporal, eBay network access, or Amazon collection by themselves.
AUTOMATION_MODE=DRY_RUN
EBAY_ENV=sandbox
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_ENABLED=false
TEMPORAL_SERVICE_TOKEN=
TEMPORAL_NAMESPACE=default
API_INTERNAL_BASE_URL=http://localhost:8080
AMAZON_REGION=DE

P7_DIAGNOSTICS_ENABLED=false
P7_DIAGNOSTIC_RUN_ID=
P7_DIAGNOSTIC_ROLE=
P7_DIAGNOSTIC_DIR=artifacts/p7-v2-diagnostics
P7_DIAGNOSTIC_BUFFER=4096
P7_DIAGNOSTIC_RUNTIME_SNAPSHOT_INTERVAL_MS=1000
# P7_DIAGNOSTIC_PG_SAMPLE_INTERVAL_MS=1000
ADMIN_PUBLIC_URL=
API_PUBLIC_URL=
LOG_LEVEL=debug

# P5 Observability (development defaults)
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MODE=local
OBSERVABILITY_ENVIRONMENT=development
LOG_FORMAT=console
LOG_INCLUDE_SOURCE=false
LOG_MAX_FIELD_LENGTH=2048
METRICS_ENABLED=true
METRICS_PATH=/internal/metrics
METRICS_INTERNAL_ONLY=true
# Only trust reverse proxies explicitly listed here. Keep loopback for a local Nginx sidecar.
HTTP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Keep aligned with the exact /internal/metrics allowlist in Nginx.
METRICS_ALLOWLIST_CIDRS=127.0.0.1/32,::1/128
TRACING_ENABLED=false
OTEL_SERVICE_NAME=trademind-api
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=0
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXPORT_QUEUE_SIZE=1024
OTEL_EXPORT_BATCH_SIZE=128
OTEL_EXPORT_RETRY_MAX=2
ALERTING_ENABLED=true
ALERT_DEFAULT_COOLDOWN_SECONDS=300
ALERT_RECOVERY_ENABLED=true
DB_SLOW_QUERY_THRESHOLD_MS=500
DB_TRACE_ENABLED=false

# AES-GCM master key for encrypting settings (64-char hex, base64 of 32 bytes, 32-char raw, or any passphrase hashed with SHA-256)
APP_MASTER_KEY=

# Feature gates (production must disable dangerous flags)
ENABLE_SWAGGER=true
ENABLE_DEV_ROUTES=true
ENABLE_DEMO_SEED=true
ENABLE_DEBUG_ENDPOINTS=true

# First admin when admin_users is empty: set EMAIL and/or PHONE (+ password).
# This account is created with role=admin (full permissions) and kept in sync on startup.
# Login is email or mobile only — not by internal username (production: require ADMIN_BOOTSTRAP_PASSWORD).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

# P7-V2 performance harness accounts (APP_ENV=performance only; never use in production)
# P7V2_PERF_ADMIN_PASSWORD=
# P7V2_PERF_TENANT_ADMIN_PASSWORD=
# P7V2_PERF_OPERATOR_PASSWORD=
# P7V2_PERF_READONLY_PASSWORD=
# P7V2_PERF_DISABLED_PASSWORD=
# P7V2_WEBHOOK_TEST_SECRET=trademind-internal-test-webhook-secret
# P7_PERF_DEFAULT_TENANT_ID=1

# -----------------------------------------------------------------------------
# Database (Gin main service) — defaults to PostgreSQL; set DB_DRIVER=mysql to use MySQL
# -----------------------------------------------------------------------------
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
# Real local or server passwords should only be written to `.env` / Secret Store; do not commit real values.
DB_PASSWORD=change-me-local-database
DB_NAME=trademind
DB_TIMEZONE=UTC

# Docker Compose PostgreSQL bootstrap. Production must override the password via a runtime secret.
POSTGRES_DB=trademind
POSTGRES_USER=trademind
POSTGRES_PASSWORD=change-me-local-docker

# -----------------------------------------------------------------------------
# Redis (queue / cache)
# -----------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Isolated test connections are only supplied by the local `.env` or CI process environment; the template contains no credentials.
TEST_DATABASE_URL=
TEST_REDIS_URL=

# -----------------------------------------------------------------------------
# JWT / session (backend)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# Phase P4 — Auth & session (development defaults to legacy; staging/production use secure_session)
# AUTH_SESSION_MODE=legacy_local_storage|secure_session
AUTH_SESSION_MODE=legacy_local_storage
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_SECURE_COOKIE=false
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_ACCOUNT_LOCK_MINUTES=30
AUTH_LOGIN_IP_RATE_LIMIT=30
AUTH_REFRESH_RATE_LIMIT=60
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_CHANGE_ON_ADMIN_RESET=true
# JWT key version (optional; falls back to JWT_SECRET when unset)
# JWT_ACTIVE_KEY_ID=default
# JWT_ACTIVE_SECRET=
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_SECRET=
JWT_ROTATION_GRACE_MINUTES=60
# APP_MASTER_KEY keyring (optional, versioned)
# APP_MASTER_ACTIVE_KEY_ID=default
# APP_MASTER_ACTIVE_KEY=
# APP_MASTER_PREVIOUS_KEYS={}
UPLOAD_MAX_FILES=10
UPLOAD_MAX_IMAGE_PIXELS=50000000
UPLOAD_MAX_IMAGE_WIDTH=8192
UPLOAD_MAX_IMAGE_HEIGHT=8192
UPLOAD_MAX_ANIMATION_FRAMES=300

# Phase P4.1 — Tenant isolation (staging/production forbid tenant fallback)
# --- Phase P4.1 tenant isolation (local dev defaults to legacy tenant_id=0) ---
# Optional: simulate a non-zero tenant in development (e.g. multi-tenant testing).
# ENABLE_DEV_DEFAULT_TENANT=true
# DEV_DEFAULT_TENANT_ID=1
# ENABLE_DEMO_DEFAULT_TENANT=true
# DEMO_DEFAULT_TENANT_ID=1
PRIVATE_DOWNLOAD_URL_TTL_SECONDS=300
EXPORT_DOWNLOAD_URL_TTL_SECONDS=3600
SENSITIVE_DOWNLOAD_URL_TTL_SECONDS=120

# Max single upload file size (MB), default 10
UPLOAD_MAX_MB=10

# -----------------------------------------------------------------------------
# Storage fail-fast (aligned with settings.storage.kind; staging/production forbid local)
# -----------------------------------------------------------------------------
# Allowed: local, cos, oss, s3, r2, minio. development defaults to local; staging/production must use object storage.
STORAGE_PROVIDER=local

# -----------------------------------------------------------------------------
# CORS (development auto-allows localhost when unconfigured; staging/production must set this)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
CORS_ALLOWED_HEADERS=Authorization, Content-Type, X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=43200

# -----------------------------------------------------------------------------
# Database migration lock (PostgreSQL advisory lock; serializes AutoMigrate across multi-instance startup)
# -----------------------------------------------------------------------------
MIGRATION_RUN_ON_STARTUP=true
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Object storage notes (works without env vars too: configure settings.storage via "Storage Settings" in the admin panel)
# -----------------------------------------------------------------------------
# Local example: kind=local, local_root=data/uploads (relative path resolves to data/uploads under the repo root), public_base=/static
# TRADEMIND_REPO_ROOT=   # optional; monorepo root directory, auto-detected upward from the backend working directory when unset
# AWS S3 example: kind=s3, s3_region=us-east-1, s3_bucket=your-bucket, leave s3_endpoint empty to use the default partition
# Cloudflare R2: kind=r2, s3_endpoint=https://<account_id>.r2.cloudflarestorage.com, s3_region=auto
# MinIO: kind=minio, s3_endpoint=http://127.0.0.1:9000, s3_force_path_style=true, s3_public_base=http://127.0.0.1:9000/bucket or a gateway/CDN prefix
# Secrets: s3_access_key_id and s3_secret_access_key are stored only in the DB (AES-GCM); do not write them to this file.
# Tencent Cloud COS (native SDK): kind=cos; cos_bucket=example myapp-1250000000 (or bare bucket name myapp + cos_app_id=1250000000), cos_region=ap-guangzhou;
# cos_secret_id / cos_secret_key are stored encrypted in the DB only; optional cos_endpoint for a custom domain; optional cos_public_base for an outbound CDN prefix (otherwise uses the bucket's default domain); cos_use_https=true
# Alibaba Cloud OSS (native SDK): kind=oss; oss_endpoint=https://oss-cn-guangzhou.aliyuncs.com, oss_bucket=your-bucket;
# oss_access_key_id / oss_access_key_secret are stored encrypted in the DB only; oss_public_base should be a CDN/bucket public prefix; oss_use_https=true

# Go API → Node collector (orchestrates collection; must match the COLLECTOR_HTTP_ADDR port)
COLLECTOR_BASE_URL=http://127.0.0.1:3100
# HTTP timeout (seconds) for the backend calling the collector; Taobao/Tmall auto-relax this based on page-open timeout, recommended >= 120
COLLECTOR_TIMEOUT_SECONDS=120
# Internal Bearer token shared between backend and Collector; production must use a unique random value (at least 32 chars), do not commit the real value
COLLECTOR_SERVICE_TOKEN=

# Collection async queue (Redis LIST, consumed by Worker; submitting tasks requires Redis to be available)
COLLECT_QUEUE_ENABLED=false
COLLECT_WORKER_CONCURRENCY=2
COLLECT_QUEUE_NAME=collect:tasks
# Max URLs per batch collection request (POST /collect/batches)
COLLECT_BATCH_MAX_URLS=50

# 1688 batch collection conservative throttling (bulk tasks only; single-link collection unaffected)
COLLECT_BATCH_CONCURRENCY_1688=1
COLLECT_BATCH_DELAY_MIN_MS_1688=1500
COLLECT_BATCH_DELAY_MAX_MS_1688=5000
COLLECT_BATCH_RETRY_ON_BLOCKED=false
COLLECT_BATCH_RETRY_ON_TIMEOUT=false
COLLECT_BATCH_MAX_RETRIES_1688=2

# Worker automatic backoff retry
COLLECT_AUTO_RETRY_ENABLED=false
COLLECT_MAX_RETRIES=3
COLLECT_RETRY_BASE_DELAY_SECONDS=30
COLLECT_RETRY_MAX_DELAY_SECONDS=600

# Image task async queue (Redis LIST; POST /image/tasks enqueues, in-process Image Worker consumes via BRPOP)
# When IMAGE_QUEUE_ENABLED=false: the create endpoint executes synchronously within the same request (recommended for local development only)
IMAGE_QUEUE_ENABLED=false
IMAGE_QUEUE_NAME=image:tasks
IMAGE_WORKER_CONCURRENCY=2
# Per-task provider call context limit (seconds); the smaller of this and settings.image.timeout_sec is used
IMAGE_TASK_TIMEOUT_SECONDS=120
# On failure, enters retrying + next_retry_at; the in-process scheduler LPUSHes once due (requires IMAGE_QUEUE_ENABLED=true)
IMAGE_AUTO_RETRY_ENABLED=false
IMAGE_MAX_RETRIES=2
IMAGE_RETRY_BASE_DELAY_SECONDS=30
IMAGE_RETRY_MAX_DELAY_SECONDS=300
# Image text translation: optional custom font path (Noto/Microsoft YaHei recommended for CJK); Docker has fonts-noto-cjk installed by default
# TRANSLATE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Order sync async queue (Redis LIST; Worker BRPOP; when ORDER_SYNC_QUEUE_ENABLED=false, executes synchronously in the API process after creation)
ORDER_SYNC_QUEUE_ENABLED=false
ORDER_SYNC_QUEUE_NAME=order:sync:tasks
ORDER_SYNC_WORKER_CONCURRENCY=1
ORDER_SYNC_TASK_TIMEOUT_SECONDS=120

# Customer service message Redis queue infrastructure. The auto-sync toggle is managed under Admin "Customer Service / AI Auto-Reply".
CUSTOMER_MESSAGE_SYNC_QUEUE_NAME=customer:message:sync:tasks
CUSTOMER_MESSAGE_SYNC_WORKER_CONCURRENCY=1
CUSTOMER_MESSAGE_SYNC_TASK_TIMEOUT_SECONDS=120

# AI customer service auto-reply queue infrastructure. The master switch and polling interval are managed on the Admin page; disabled by default.
CUSTOMER_AUTO_REPLY_QUEUE_NAME=customer:auto:reply:tasks
CUSTOMER_AUTO_REPLY_WORKER_CONCURRENCY=1

# Product publish async queue (Redis LIST; when PRODUCT_PUBLISH_QUEUE_ENABLED=false, tasks execute synchronously in the API process after creation)
PRODUCT_PUBLISH_QUEUE_ENABLED=false
PRODUCT_PUBLISH_QUEUE_NAME=product:publish:tasks
PRODUCT_PUBLISH_WORKER_CONCURRENCY=1
PRODUCT_PUBLISH_TASK_TIMEOUT_SECONDS=180
# Batch publish matrix limits (Phase A2.1)
PUBLISH_BATCH_MAX_PRODUCTS=100
PUBLISH_BATCH_MAX_TARGETS=20
PUBLISH_BATCH_MAX_TASKS=300

# Inventory sync async queue (Redis LIST; Worker BRPOP; when INVENTORY_SYNC_QUEUE_ENABLED=false, tasks execute synchronously in the creating process)
INVENTORY_SYNC_QUEUE_ENABLED=false
INVENTORY_SYNC_QUEUE_NAME=inventory:sync:tasks
INVENTORY_SYNC_WORKER_CONCURRENCY=1
INVENTORY_SYNC_TASK_TIMEOUT_SECONDS=120

# Collection task DB lease TTL (reclaimed by multi-instance Workers; should be >= Collector timeout + margin)
COLLECT_TASK_TIMEOUT_SECONDS=600

# Multi-instance Worker: instance registry + heartbeat + task lease + Reaper (when heartbeat is disabled, a workerId is still generated and a DB lease written, but nothing is persisted to worker_instances)
WORKER_HEARTBEAT_ENABLED=false
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_AFTER_SECONDS=30
WORKER_REAPER_ENABLED=false
WORKER_REAPER_INTERVAL_SECONDS=15
WORKER_LEGACY_RUNNING_TIMEOUT_SECONDS=1800

# Task alerts: in-process periodic scan (not Redis). This is only a deployment-level gate; whether the feature is enabled and the scan interval are configured in the admin panel under "System Settings" settings.taskcenter.
TASK_ALERT_SCAN_ENABLED=false
TASK_ALERT_SCAN_INTERVAL_SECONDS=60
TASK_ALERT_SCAN_LOOKBACK_MINUTES=120
TASK_ALERT_SCAN_LOCK_TTL_SECONDS=120

# -----------------------------------------------------------------------------
# P7 Performance / capacity / rate limiting foundation
# -----------------------------------------------------------------------------
PERFORMANCE_TEST_MODE=false
ALLOW_PERFORMANCE_DATASET=false
EXTERNAL_PROVIDER_MODE=mock
DOUYIN_WRITE_ENABLED=false
AUTO_LISTING_ENABLED=false
PERFORMANCE_DATASET_MAX_ROWS=2000000
PERFORMANCE_TEST_MAX_VUS=50
PERFORMANCE_TEST_MAX_DURATION_SECONDS=1800

PAGINATION_DEFAULT_LIMIT=50
PAGINATION_MAX_LIMIT=200
PAGINATION_MAX_OFFSET=10000
PAGINATION_CURSOR_SIGNING_KEY=

DB_MAX_OPEN_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONN_MAX_LIFETIME_SECONDS=3600
DB_CONN_MAX_IDLE_TIME_SECONDS=900
DB_QUERY_TIMEOUT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000

WORKER_CONCURRENCY_DEFAULT=2
WORKER_QUEUE_CAPACITY=1000
WORKER_MAX_INFLIGHT=100
WORKER_PREFETCH=10
WORKER_SHUTDOWN_TIMEOUT_SECONDS=60

RATE_LIMIT_ENABLED=false
RATE_LIMIT_MODE=local
RATE_LIMIT_REDIS_PREFIX=trademind:ratelimit
RATE_LIMIT_FAIL_MODE=closed
RATE_LIMIT_LOCAL_FALLBACK=true
RATE_LIMIT_POLICY_VERSION=p7-default-v1

CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ENTRIES=10000
CACHE_SINGLEFLIGHT_ENABLED=true

EXPORT_BATCH_SIZE=500
EXPORT_MAX_ROWS=100000
EXPORT_MAX_BYTES=104857600
EXPORT_MAX_CONCURRENT=2

PPROF_ENABLED=false
PPROF_INTERNAL_ONLY=true

# -----------------------------------------------------------------------------
# P10 credential, read-only Provider, safety controls and manual acceptance
# -----------------------------------------------------------------------------
# P10 pre-production reuses APP_ENV=staging. Fill these values only in the
# target server's ignored `.env`; keep development/test/production resources distinct.
P10_ENVIRONMENT_PURPOSE=
P10_DEPLOYMENT_ID=
P10_COMPOSE_PROJECT_NAME=
P10_PRODUCTION_ADMIN_PUBLIC_URL=
P10_PRODUCTION_API_PUBLIC_URL=
P10_DATABASE_PURPOSE=
P10_DATABASE_ID=
P10_PRODUCTION_DATABASE_ID=
P10_TEST_DATABASE_ID=
P10_REDIS_PURPOSE=
P10_REDIS_ID=
P10_PRODUCTION_REDIS_ID=
P10_TEST_REDIS_ID=
P10_SECRET_SOURCE=
P10_DB_PASSWORD_REF=
P10_REDIS_PASSWORD_REF=
P10_APP_MASTER_KEY_REF=
P10_JWT_SECRET_REF=
P10_PRODUCTION_COOKIE_DOMAIN=
P10_SESSION_NAMESPACE=
P10_PRODUCTION_SESSION_NAMESPACE=
P10_MIGRATION_TARGET=
P10_BACKUP_TARGET=
P10_RESTORE_TARGET=
P10_PREPRODUCTION_RESTORE_ENABLED=false
P10_PRODUCTION_RESTORE_ENABLED=false
P10_PREVIOUS_API_IMAGE=
P10_PREVIOUS_ADMIN_IMAGE=
P10_ROLLBACK_MIGRATION_COMPATIBLE=false

P10_CURRENT_ALLOWED_LEVEL=L0
P10_OFFLINE_OAUTH_ENABLED=false
P10_LOCAL_CREDENTIAL_KEY=
P10_LOCAL_CREDENTIAL_KEY_REF=local-development-v1
P10_OAUTH_STATE_TTL_SECONDS=600
P10_OAUTH_REDIRECT_ALLOWLIST=
P10_DOUYIN_API_BASE_URL=
P10_PROVIDER_REQUEST_TIMEOUT_SECONDS=30
P10_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
P10_PROVIDER_RESPONSE_HEADER_TIMEOUT_SECONDS=15
P10_PROVIDER_MAX_RESPONSE_BYTES=2097152
P10_PROVIDER_CONCURRENCY=2
P10_SKU_PAGE_SIZE=50
P10_PAGINATION_LIMIT=100
P10_REAL_PROVIDER_ENABLED=false
P10_REAL_PLATFORM_NETWORK_ENABLED=false
P10_REAL_CREDENTIALS_ENABLED=false
P10_REAL_INVENTORY_READ_ENABLED=false
P10_REAL_PRODUCT_DRAFT_WRITE_ENABLED=false
P10_INVENTORY_MUTATION_ENABLED=false
P10_BACKGROUND_WORKER_ENABLED=false
P10_AUTOMATIC_RETRY_ENABLED=false

# Legacy safety-contract names remain active fail-closed inputs in current validation.
INVENTORY_SYNC_PROVIDER_MODE=fixture
REAL_DOUYIN_ENABLED=false
REAL_PLATFORM_READ=false
REAL_PLATFORM_WRITE=false
REAL_INVENTORY_READ=false
REAL_INVENTORY_WRITE=false
INVENTORY_MUTATION_ENABLED=false
AUTO_INVENTORY_SYNC=false
AUTO_RETRY=false
INVENTORY_SYNC_AUTO_RETRY=false
INVENTORY_SYNC_BACKGROUND_WORKER_ENABLED=false
INVENTORY_SYNC_NETWORK_ACCESS=false

# -----------------------------------------------------------------------------
# Inbound platform webhooks (public POST /api/v1/webhooks/:platform/:eventType)
# -----------------------------------------------------------------------------
WEBHOOK_MAX_BODY_KB=512
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
# HMAC-SHA256 verifier for platform=internal-test; only when APP_ENV=development|test (forced off in production).
WEBHOOK_ENABLE_TEST_VERIFIER=false
WEBHOOK_WORKER_INTERVAL_SECONDS=3
DOUYIN_WEBHOOK_TEST_SHOP_BINDING_ID=
ENABLE_DOUYIN_WEBHOOK_DEMO_FALLBACK=false
# Note: recipient email, webhook, notification thresholds/levels/channels, etc. are stored only in settings (taskcenter / alert_notify); do not write them to this file.
# Alert email/webhook detail link prefix and webhook HTTP timeout are found in the admin panel under "Alert Notifications" / "System Settings".

# -----------------------------------------------------------------------------
# TikTok Shop Partner / Open Platform
# -----------------------------------------------------------------------------
# "Platform parameters" must not have real secrets written into .env or the repo. Maintain the platform_tiktok group in the admin panel under "Settings → Platform Open Config"
# (app_key in plaintext; app_secret encrypted; auth_base_url, api_base_url, redirect_uri, api_version, timeout_sec, etc.).
# Shop OAuth access_token / refresh_token are stored only in shop_auth_tokens under "Shop → Authorization"; do not write them here.

# -----------------------------------------------------------------------------
# Node collector service (Playwright) — separate process from Go API
# -----------------------------------------------------------------------------
COLLECTOR_HTTP_ADDR=:3100
# Collector HTTP protection; request body defaults to 1 MiB, the timeout only limits header/body receipt, not the page collection execution duration
COLLECTOR_MAX_REQUEST_BODY_BYTES=1048576
COLLECTOR_REQUEST_TIMEOUT_MS=15000
COLLECTOR_HEADERS_TIMEOUT_MS=10000
# open page timeout (ms); navigation default same family
COLLECTOR_GOTO_TIMEOUT_MS=45000
# 1 or true = headless (default headless); set 0 when opening login browser locally
COLLECTOR_HEADLESS=1
# 1688 persistent browser profile (login cookies); default collector/data/browser-profiles/1688
# COLLECTOR_BROWSER_PROFILE_DIR=collector/data/browser-profiles
# BROWSER_PROFILE_ROOT=collector/data/browser-profiles
# COLLECTOR_STORAGE_STATE_DIR=data/storage-states
# optional probe offer URL for auth-status check
# COLLECTOR_1688_AUTH_CHECK_URL=https://www.1688.com/
# failure debug snapshots (HTML + PNG)
# COLLECTOR_SNAPSHOT_DIR=collector/data/snapshots/1688
# optional override; default ships a modern Chrome UA in browser/manager
# COLLECTOR_USER_AGENT=
